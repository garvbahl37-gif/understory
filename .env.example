# ── CognoDB connection ───────────────────────────────────────────────────────
# Create a free (c0) instance at https://console.cognodb.com and copy the
# connection details it shows you. The password is displayed exactly once.
#
# Never commit the filled-in version of this file. .env.local is git-ignored.

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=<the password shown at instance creation>

# ── Optional tuning ──────────────────────────────────────────────────────────
# CognoDB exposes a single database; leave this alone unless you are pointing
# the app at a local Neo4j for development.
# COGNODB_DATABASE=neo4j

# Hard ceiling on any single query, in milliseconds.
# COGNODB_QUERY_TIMEOUT_MS=15000

# The free tier allows 200 connections in total. Keep each serverless instance's
# pool small so a burst of cold starts cannot exhaust it.
# COGNODB_MAX_POOL_SIZE=12

# Set to 1 to log Bolt protocol chatter while debugging.
# COGNODB_DEBUG=0
